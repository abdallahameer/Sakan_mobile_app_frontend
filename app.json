{
  "expo": {
    "name": "مسكن",
    "slug": "sakan_mobile_app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/progectImages/maskanAppIcon.png",
    "scheme": "sakanmobileapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.maskan.maskan"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/progectImages/maskanAppIcon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.maskan.maskan"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/progectImages/maskanIcon.png",
          "imageWidth": 140
        }
      ],
      [
        "react-native-maps",
        {
          "androidGoogleMapsApiKey": "AIzaSyAXuXRwT0oMXOZg99WrVIdF_ap8MjXBEA4"
        }
      ],
      "@react-native-google-signin/google-signin",
      "expo-secure-store",
      "react-native-compressor",
      "expo-video",
      "expo-image",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2e5e3a90-6fcb-4bcb-b09e-b629636938ee"
      }
    }
  }
}
